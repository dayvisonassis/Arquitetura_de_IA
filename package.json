{
  "name": "arquitetura-de-ia",
  "version": "1.0.0",
  "description": "AI Gateway: proxy de IA multi-tenant e sistema web, em apps independentes",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint:frontend": "cd apps/frontend && npm run lint:check",
    "lint:backend": "cd apps/backend && npm run lint:check",
    "lint:ia": "cd apps/ia && npm run lint:check",
    "lint:ia_simulator": "cd apps/ia_simulator && npm run lint:check",
    "lint": "npm run lint:frontend && npm run lint:backend && npm run lint:ia && npm run lint:ia_simulator",
    "test:frontend": "cd apps/frontend && npm test",
    "test:backend": "cd apps/backend && npm run test:unit",
    "test:ia": "cd apps/ia && npm test",
    "test:ia_simulator": "cd apps/ia_simulator && npm test",
    "test": "npm run test:frontend && npm run test:backend && npm run test:ia && npm run test:ia_simulator",
    "test:e2e": "playwright test --config playwright.e2e.config.js",
    "gate": "node scripts/runGate.mjs",
    "gate:typecheck-frontend": "node scripts/runGate.mjs typecheck-frontend",
    "gate:typecheck-monorepo": "node scripts/runGate.mjs typecheck-monorepo",
    "gate:lint-backend": "node scripts/runGate.mjs lint-backend",
    "gate:raw-sql-backend": "node scripts/runGate.mjs raw-sql-backend",
    "gate:query-loop-backend": "node scripts/runGate.mjs query-loop-backend",
    "gate:lint-frontend": "node scripts/runGate.mjs lint-frontend",
    "gate:lint-monorepo": "node scripts/runGate.mjs lint-monorepo",
    "gate:styles-frontend": "node scripts/runGate.mjs styles-frontend",
    "gate:build-backend": "node scripts/runGate.mjs build-backend",
    "gate:build-monorepo": "node scripts/runGate.mjs build-monorepo",
    "gate:build-frontend": "node scripts/runGate.mjs build-frontend",
    "gate:arch": "node scripts/runGate.mjs arch",
    "gate:tests-backend": "node scripts/runGate.mjs tests-backend",
    "gate:tests-frontend": "node scripts/runGate.mjs tests-frontend",
    "gate:tests-monorepo": "node scripts/runGate.mjs tests-monorepo",
    "gate:deadcode": "node scripts/runGate.mjs deadcode",
    "gate:e2e-frontend": "node scripts/runGate.mjs e2e-frontend"
  },
  "lint-staged": {
    "apps/frontend/src/**/*.{ts,html}": [
      "node scripts/lint-staged-eslint.mjs frontend",
      "prettier --write --config apps/frontend/.prettierrc"
    ],
    "apps/frontend/src/**/*.{css,scss}": [
      "prettier --write --config apps/frontend/.prettierrc"
    ],
    "apps/backend/**/*.js": [
      "node scripts/lint-staged-eslint.mjs backend",
      "prettier --write --config apps/backend/.prettierrc"
    ],
    "apps/ia/**/*.ts": [
      "node scripts/lint-staged-eslint.mjs ia",
      "prettier --write --config apps/ia/.prettierrc"
    ],
    "apps/ia_simulator/**/*.ts": [
      "node scripts/lint-staged-eslint.mjs ia_simulator",
      "prettier --write --config apps/ia_simulator/.prettierrc"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "dependency-cruiser": "^18.5.0",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "picomatch": "^4.0.7",
    "prettier": "3.8.3",
    "typescript": "~5.6.3"
  }
}
