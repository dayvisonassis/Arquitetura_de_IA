{
  "name": "ai-gateway-backend",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --legacy-watch --exec babel-node ./index.js",
    "build": "babel index.js loader.js database.js knexfile.js redis-client.js -d dist && babel src -d dist/src",
    "prod": "cross-env NODE_ENV=production node dist/index.js",
    "test:unit": "cross-env NODE_ENV=testing jest __tests__/unit/",
    "test:integration": "npm run migrations:test && cross-env NODE_ENV=testing jest __tests__/integration/ --runInBand",
    "test:contracts": "node __tests__/utils/reset-pacts.js && cross-env NODE_ENV=testing jest __tests__/contracts/ --runInBand",
    "migrations:dev": "cross-env NODE_ENV=development knex migrate:latest",
    "migrations:test": "cross-env NODE_ENV=testing knex migrate:latest",
    "migrations:prod": "cross-env NODE_ENV=production knex migrate:latest",
    "migration:add": "cross-env NODE_ENV=development knex migrate:make",
    "seed:dev": "cross-env NODE_ENV=development knex seed:run",
    "seed:run": "knex seed:run",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "lint:check": "eslint . --ext .js --max-warnings 0",
    "format": "prettier --write --config ./.prettierrc \"**/*.js\"",
    "format:check": "prettier --check --config ./.prettierrc \"**/*.js\"",
    "check": "npm run lint:check && npm run format:check"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "knex": "^3.3.0",
    "mysql2": "^3.24.5",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/node": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@pact-foundation/pact": "^15.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "3.8.3",
    "supertest": "^7.3.1"
  }
}
