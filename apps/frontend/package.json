{
  "name": "ai-gateway-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "start:docker": "ng serve --host 0.0.0.0 --port 4200 --poll 2000",
    "build": "ng build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "ng lint",
    "lint:fix": "eslint src/ --ext .ts,.html --fix",
    "lint:check": "eslint src/ --ext .ts,.html --max-warnings 0",
    "format": "prettier --write --config ./.prettierrc \"src/**/*.{ts,html,css,scss}\"",
    "format:check": "prettier --check --config ./.prettierrc \"src/**/*.{ts,html,css,scss}\""
  },
  "dependencies": {
    "@angular/animations": "~19.2.20",
    "@angular/cdk": "~19.2.19",
    "@angular/common": "~19.2.20",
    "@angular/compiler": "~19.2.20",
    "@angular/core": "~19.2.20",
    "@angular/forms": "~19.2.20",
    "@angular/material": "~19.2.19",
    "@angular/platform-browser": "~19.2.20",
    "@angular/platform-browser-dynamic": "~19.2.20",
    "@angular/router": "~19.2.20",
    "@fontsource/open-sans": "^5.3.0",
    "material-icons": "^1.13.14",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~19.2.17",
    "@angular-eslint/builder": "^18.4.3",
    "@angular-eslint/eslint-plugin": "^18.4.3",
    "@angular-eslint/eslint-plugin-template": "^18.4.3",
    "@angular-eslint/template-parser": "^18.4.3",
    "@angular/cli": "~19.2.17",
    "@angular/compiler-cli": "~19.2.20",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^15.0.3",
    "prettier": "3.8.3",
    "stylelint": "^17.16.0",
    "typescript": "~5.6.3"
  }
}
