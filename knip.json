{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs", "tests/e2e/**/*.ts"],
      "playwright": { "config": ["playwright.e2e.config.ts"] }
    },
    "apps/web": {
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": ["ejs"]
    }
  }
}
